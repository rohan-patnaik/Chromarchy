#!/bin/sh
set -u

report_failure() {
  title=$1
  detail=$2
  printf 'Chromarchy: %s: %s\n' "$title" "$detail" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=Chromarchy "$title" "$detail" >/dev/null 2>&1 || :
  fi
}

binary=
first_unusable=
remaining_path=${PATH-}
while :; do
  case $remaining_path in
    *:*)
      directory=${remaining_path%%:*}
      remaining_path=${remaining_path#*:}
      last_component=0
      ;;
    *)
      directory=$remaining_path
      last_component=1
      ;;
  esac
  [ -n "$directory" ] || directory=.
  candidate=$directory/chromarchy
  if [ -f "$candidate" ] && [ -x "$candidate" ]; then
    binary=$candidate
    break
  fi
  if { [ -e "$candidate" ] || [ -L "$candidate" ]; } &&
     [ -z "$first_unusable" ]; then
    first_unusable=$candidate
  fi
  [ "$last_component" -eq 0 ] || break
done
if [ -z "$binary" ]; then
  if [ -n "$first_unusable" ]; then
    report_failure "Chromarchy cannot be launched" \
      "Found $first_unusable on PATH, but it is not an executable regular file. Check its permissions or installation."
    exit 126
  fi
  report_failure "Chromarchy is not installed" \
    "Install the native chromarchy binary on PATH, then try again."
  exit 127
fi

"$binary" "$@" </dev/null &
child=$!
wait "$child"
status=$?
if [ "$status" -eq 0 ]; then
  exit 0
fi
report_failure "Chromarchy exited unexpectedly" \
  "The native application at $binary exited with status $status. Run it in a terminal for details."
exit "$status"
