#!/bin/sh
set -u

report_failure() {
  title=$1
  detail=$2
  printf 'Chromarchy: %s: %s\n' "$title" "$detail" >&2
  if command -v notify-send >/dev/null 2>&1; then
    notify-send --app-name=Chromarchy "$title" "$detail" >/dev/null 2>&1 || :
  fi
}

binary=
old_ifs=$IFS
IFS=:
for directory in ${PATH:-}; do
  [ -n "$directory" ] || directory=.
  candidate=$directory/chromarchy
  if [ -e "$candidate" ] || [ -L "$candidate" ]; then
    binary=$candidate
    break
  fi
done
IFS=$old_ifs
if [ -z "$binary" ]; then
  report_failure "Chromarchy is not installed" \
    "Install the native chromarchy binary on PATH, then try again."
  exit 127
fi
if [ ! -f "$binary" ] || [ ! -x "$binary" ]; then
  report_failure "Chromarchy cannot be launched" \
    "Found $binary on PATH, but it is not an executable regular file. Check its permissions or installation."
  exit 126
fi

"$binary" "$@" </dev/null &
child=$!
wait "$child"
status=$?
if [ "$status" -eq 0 ]; then
  exit 0
fi
report_failure "Chromarchy exited unexpectedly" \
  "The native application at $binary exited with status $status. Run it in a terminal for details."
exit "$status"
