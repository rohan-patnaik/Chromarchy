pkgname=chromarchy-git
pkgver=0.1.0.r0.g0000000
pkgrel=1
pkgdesc='Offline-first professional raster image editor for Omarchy Quattro'
arch=('x86_64')
url='https://github.com/rohan-patnaik/Chromarchy'
license=('MIT')
depends=('qt6-base' 'qt6-imageformats')
makedepends=('cmake' 'git' 'ninja')
provides=('chromarchy')
conflicts=('chromarchy')
if [[ -n ${CHROMARCHY_SOURCE_ARCHIVE:-} ]]; then
  source=("$CHROMARCHY_SOURCE_ARCHIVE")
else
  source=('Chromarchy::git+https://github.com/rohan-patnaik/Chromarchy.git')
fi
# Exact-source CI supplies the computed digest for its local archive. The
# rolling VCS development fallback uses makepkg's standard SKIP convention
# because a moving git source cannot have a stable archive checksum.
b2sums=("${CHROMARCHY_SOURCE_B2SUM:-SKIP}")

pkgver() {
  cd Chromarchy
  if [[ -f .chromarchy-source-revision ]]; then
    local revision
    revision=$(<.chromarchy-source-revision)
    [[ $revision =~ ^[0-9a-f]{40}$ ]] || return 1
    printf '0.1.0.r0.g%s' "${revision:0:7}"
    return
  fi
  printf '0.1.0.r%s.g%s' "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  if [[ -n ${CHROMARCHY_EXPECTED_REVISION:-} ]]; then
    [[ -n ${CHROMARCHY_SOURCE_ARCHIVE:-} ]]
    [[ -n ${CHROMARCHY_SOURCE_B2SUM:-} ]]
    [[ -f Chromarchy/.chromarchy-source-revision ]]
    local revision
    revision=$(<Chromarchy/.chromarchy-source-revision)
    [[ $revision == "$CHROMARCHY_EXPECTED_REVISION" ]]
  fi
}

build() {
  cmake -S Chromarchy -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DBUILD_TESTING=ON
  cmake --build build
}

check() {
  ctest --test-dir build -LE benchmark --output-on-failure
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 Chromarchy/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 Chromarchy/README.md \
    "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 Chromarchy/docs/PARITY.md \
    "$pkgdir/usr/share/doc/$pkgname/PARITY.md"
  install -Dm644 Chromarchy/docs/PERFORMANCE.md \
    "$pkgdir/usr/share/doc/$pkgname/PERFORMANCE.md"
  install -Dm644 Chromarchy/docs/FORMATS.md \
    "$pkgdir/usr/share/doc/$pkgname/FORMATS.md"
  install -Dm644 Chromarchy/docs/PIXEL_STORAGE.md \
    "$pkgdir/usr/share/doc/$pkgname/PIXEL_STORAGE.md"
  install -Dm644 Chromarchy/docs/RECENT_DOCUMENTS.md \
    "$pkgdir/usr/share/doc/$pkgname/RECENT_DOCUMENTS.md"
  install -Dm644 Chromarchy/docs/VIEW_ROTATION.md \
    "$pkgdir/usr/share/doc/$pkgname/VIEW_ROTATION.md"
  install -Dm644 Chromarchy/docs/OFFLINE_HELP.md \
    "$pkgdir/usr/share/doc/$pkgname/OFFLINE_HELP.md"
}
